# WikiGraph Environment Configuration
# Copy this file to .env and fill in your secrets.

# AI Provider Configuration
# Options: "mock" (default, free), "gemini" (requires API key)
AI_PROVIDER=gemini

# Google Gemini API Key
# Get a free key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# (Optional) Test Mode
# TEST_MODE=true
