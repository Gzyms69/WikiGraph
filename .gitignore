# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv*/
env*/
.venv/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Data files (LARGE - DO NOT COMMIT)
data/
# Exceptions (if we want to keep structure, but generally ignore all data)
!data/.gitkeep

# Backups and archives
*.tar.gz
*.zip
*.7z

# File backups (use git instead)
*.bak
*.bak_*
*.backup
*.root_backup

# Profiling artifacts
*.prof

# One-off audit outputs
neo4j_audit.json
sqlite_audit.json

# Logs
*.log
logs/

# Docker
docker/*.tar
*.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary & runtime files
*.tmp
*.temp
.run/

# Environment variables
.env
.env.local